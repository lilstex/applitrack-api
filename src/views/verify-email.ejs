<!DOCTYPE html>
<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta
      name="format-detection"
      content="telephone=no,address=no,email=no,date=no,url=no"
    />
    <title>Verify Your AppliTrack Email</title>
    <!--[if mso]>
      <noscript
        ><xml
          ><o:OfficeDocumentSettings
            ><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings
          ></xml
        ></noscript
      >
    <![endif]-->
    <style>
      * {
        box-sizing: border-box;
      }
      body,
      table,
      td,
      p,
      a,
      li {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table,
      td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
        border-collapse: collapse;
      }
      img {
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
        -ms-interpolation-mode: bicubic;
        display: block;
      }
      body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
      }

      body {
        background-color: #f5f5f5;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
      }

      .shell {
        width: 100%;
        background-color: #e7e6f5;
      }

      /* Card */
      .card {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        background-color: #12103a;
        border-radius: 20px;
        border: 1px solid rgba(120, 80, 240, 0.2);
      }

      .header {
        background: linear-gradient(150deg, #1a1258 0%, #22165e 100%);
        border-radius: 20px 20px 0 0;
        padding: 36px 40px 0;
        text-align: center;
      }
      .header-stripe {
        height: 3px;
        background: linear-gradient(
          90deg,
          #5838c8 0%,
          #8250ef 50%,
          #3cc8dc 100%
        );
        border-radius: 0 0 2px 2px;
        margin-top: 28px;
      }

      .body {
        padding: 40px 40px 32px;
      }

      .greeting {
        margin: 0 0 8px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: rgba(180, 160, 230, 0.65);
      }

      .headline {
        margin: 0 0 16px;
        font-size: 28px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: #ffffff;
      }

      .headline-accent {
        background: linear-gradient(135deg, #a080ff 0%, #5cc8dc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        /* Fallback for Outlook */
        color: #8a60f0;
      }

      .body-text {
        margin: 0 0 28px;
        font-size: 15px;
        line-height: 1.75;
        color: rgba(210, 200, 245, 0.78);
      }

      .body-text strong {
        color: rgba(225, 215, 255, 0.95);
        font-weight: 600;
      }

      /*  CTA Button */
      .cta-outer {
        text-align: center;
        margin: 0 0 32px;
      }
      .cta-button {
        display: inline-block;
        padding: 15px 42px;
        background: linear-gradient(135deg, #5838c8 0%, #7a50ef 100%);
        color: #ffffff !important;
        text-decoration: none !important;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.01em;
        border-radius: 14px;
        border: 1px solid rgba(160, 120, 255, 0.35);
        mso-padding-alt: 0;
        box-shadow: 0 8px 32px rgba(88, 56, 200, 0.5);
      }

      /* Welcome strip */
      .welcome-strip {
        background: linear-gradient(
          135deg,
          rgba(88, 56, 200, 0.12),
          rgba(60, 200, 220, 0.08)
        );
        border: 1px solid rgba(120, 80, 240, 0.22);
        border-radius: 12px;
        padding: 16px 20px;
        margin: 0 0 28px;
        text-align: center;
      }
      .welcome-strip-label {
        margin: 0 0 4px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: rgba(160, 128, 255, 0.7);
      }
      .welcome-strip-text {
        margin: 0;
        font-size: 13px;
        line-height: 1.65;
        color: rgba(220, 210, 255, 0.85);
      }
      .welcome-strip-text strong {
        color: #ffffff;
        font-weight: 700;
      }

      /* Info box */
      .info-box {
        background: rgba(88, 56, 200, 0.08);
        border: 1px solid rgba(120, 80, 240, 0.18);
        border-radius: 12px;
        padding: 18px 20px;
        margin: 0 0 28px;
      }
      .info-row {
        margin-bottom: 10px;
      }
      .info-row:last-child {
        margin-bottom: 0;
      }
      .info-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #7a50ef;
        vertical-align: middle;
        margin-right: 10px;
        margin-top: -2px;
      }
      .info-dot-teal {
        background: #3cc8dc;
      }
      .info-text {
        display: inline;
        font-size: 13px;
        line-height: 1.65;
        color: rgba(195, 182, 240, 0.8);
        vertical-align: middle;
      }
      .info-text strong {
        color: rgba(220, 210, 255, 0.95);
        font-weight: 600;
      }

      /* Fallback link */
      .fallback-label {
        margin: 0 0 8px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: rgba(150, 136, 200, 0.55);
      }
      .fallback-box {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 8px;
        padding: 12px 16px;
        margin: 0 0 28px;
        word-break: break-all;
      }
      .fallback-box a {
        font-size: 11px;
        color: #9080e0 !important;
        text-decoration: underline;
        line-height: 1.6;
      }

      /* Divider */
      .divider {
        height: 1px;
        border: none;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(120, 80, 240, 0.22),
          transparent
        );
        margin: 0 0 24px;
      }

      /* Fine print */
      .fine-print {
        margin: 0;
        font-size: 12.5px;
        line-height: 1.7;
        color: rgba(150, 136, 200, 0.55);
      }
      .fine-print a {
        color: #8878d8 !important;
        text-decoration: underline;
      }

      /* Footer  */
      .footer {
        background: rgba(0, 0, 0, 0.22);
        border-top: 1px solid rgba(120, 80, 240, 0.12);
        border-radius: 0 0 20px 20px;
        padding: 22px 40px;
        text-align: center;
      }
      .footer-brand {
        margin: 0 0 6px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: -0.01em;
        color: rgba(175, 158, 225, 0.45);
      }
      .footer-brand span {
        color: rgba(138, 96, 240, 0.55);
      }
      .footer-meta {
        margin: 0;
        font-size: 11px;
        line-height: 1.65;
        color: rgba(130, 116, 185, 0.38);
      }

      /* Responsive  */
      @media only screen and (max-width: 600px) {
        .card {
          border-radius: 16px !important;
        }
        .header {
          padding: 28px 24px 0 !important;
          border-radius: 16px 16px 0 0 !important;
        }
        .body {
          padding: 28px 24px 24px !important;
        }
        .footer {
          padding: 18px 24px !important;
          border-radius: 0 0 16px 16px !important;
        }
        .headline {
          font-size: 24px !important;
        }
        .cta-button {
          padding: 14px 32px !important;
          font-size: 14px !important;
        }
      }
    </style>
  </head>

  <body>
    <table
      class="shell"
      cellpadding="0"
      cellspacing="0"
      border="0"
      role="presentation"
    >
      <tr>
        <td align="center" style="padding: 40px 16px">
          <!-- CARD -->
          <table
            class="card"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
          >
            <!-- HEADER -->
            <tr>
              <td class="header">
                <img
                  src="https://res.cloudinary.com/lilstex/image/upload/v1772208871/logo-wordmark-lg_zg0lvw.png"
                  alt="AppliTrack - AI-Powered Applications"
                  width="200"
                  style="
                    width: 200px;
                    max-width: 200px;
                    height: auto;
                    margin: 0 auto;
                  "
                />
                <div class="header-stripe"></div>
              </td>
            </tr>

            <!-- BODY  -->
            <tr>
              <td class="body">
                <!-- Greeting -->
                <p class="greeting">Welcome, <%= user %></p>

                <!-- Headline -->
                <h1 class="headline">
                  Confirm your<br />
                  <!--[if mso
                    ]><span style="color: #8a60f0">email address</span><!
                  [endif]-->
                  <!--[if !mso]><!-->
                  <span class="headline-accent">email address</span>
                  <!--<![endif]-->
                </h1>

                <!-- Copy -->
                <p class="body-text">
                  Thanks for joining AppliTrack. One quick step before you start
                  generating tailored resumes: confirm this is really your email
                  by clicking the button below. The link is valid for
                  <strong>2&nbsp;hours</strong>.
                </p>

                <!-- CTA -->
                <div class="cta-outer">
                  <!--[if mso]>
                    <v:roundrect
                      xmlns:v="urn:schemas-microsoft-com:vml"
                      xmlns:w="urn:schemas-microsoft-com:office:word"
                      href="<%= link %>"
                      style="height: 50px; v-text-anchor: middle; width: 250px"
                      arcsize="28%"
                      stroke="f"
                      fillcolor="#5838c8"
                    >
                      <w:anchorlock />
                      <center
                        style="
                          color: #ffffff;
                          font-family: sans-serif;
                          font-size: 15px;
                          font-weight: 700;
                        "
                      >
                        Verify My Email &rarr;
                      </center>
                    </v:roundrect>
                  <![endif]-->
                  <!--[if !mso]><!-->
                  <a
                    href="<%= link %>"
                    class="cta-button"
                    target="_blank"
                    rel="noopener"
                  >
                    Verify My Email &nbsp;&rarr;
                  </a>
                </div>

                <div class="welcome-strip">
                  <p class="welcome-strip-label">Starter credits ready</p>
                  <p class="welcome-strip-text">
                    Once verified, <strong>10 free credits</strong> are added to
                    your account so you can generate your first tailored resume
                    right away.
                  </p>
                </div>

                <!-- Info box -->
                <div class="info-box">
                  <div class="info-row">
                    <span class="info-dot"></span>
                    <span class="info-text">
                      This link expires in <strong>24 hours</strong> from when
                      it was sent.
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-dot"></span>
                    <span class="info-text">
                      The link can only be <strong>used once</strong>, so keep
                      this email safe until you&rsquo;ve verified.
                    </span>
                  </div>
                  <div class="info-row">
                    <span class="info-dot info-dot-teal"></span>
                    <span class="info-text">
                      Didn&rsquo;t sign up for AppliTrack? You can safely ignore
                      this email &mdash; no account will be created.
                    </span>
                  </div>
                </div>

                <!-- Fallback link -->
                <p class="fallback-label">
                  Button not working? Copy this link into your browser
                </p>
                <div class="fallback-box">
                  <a href="<%= link %>" target="_blank" rel="noopener"
                    ><%= link %></a
                  >
                </div>

                <!-- Divider -->
                <hr class="divider" />

                <!-- Fine print -->
                <p class="fine-print">
                  For your security, AppliTrack staff will
                  <strong style="color: rgba(190, 175, 240, 0.65)"
                    >never</strong
                  >
                  ask for your password or this verification link. If you have
                  any questions, reach us at
                  <a href="mailto:hello@shotnubsolutions.com"
                    >hello@shotnubsolutions.com</a
                  >.
                </p>
              </td>
            </tr>

            <tr>
              <td class="footer">
                <p class="footer-brand">Appli<span>Track</span></p>
                <p class="footer-meta">
                  &copy; <%= new Date().getFullYear() %> ShotNub Solutions
                  &middot; All rights reserved<br />
                  You&rsquo;re receiving this email because someone (hopefully
                  you) signed up for an AppliTrack account with this address.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
