<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    @page { margin: 48px 68px 32px; size: A4; }
    @page :first { margin: 0; size: A4; }
    html, body { margin: 0; padding: 0; background: white; orphans: 3; widows: 3; }
    body { font-family: 'DM Sans', -apple-system, Helvetica, sans-serif; color: #1c1c1e; font-size: 13px; line-height: 1.55; }

    .page { padding: 56px 68px 64px; }
    header h1 { font-size: 42px; font-weight: 300; letter-spacing: -0.025em; line-height: 1; margin: 0 0 8px; color: #0d0d0d; }
    .contact-row { display: flex; gap: 18px; font-size: 11px; color: #6e6e73; flex-wrap: wrap; margin-bottom: 28px; }
    .rule { height: 1px; background: #e5e5ea; margin-bottom: 24px; }
    .summary { font-size: 14px; line-height: 1.85; color: #3a3a3c; max-width: 58ch; margin: 0 0 24px; }
    .sl { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: #8e8e93; margin-bottom: 16px; page-break-after: avoid; }

    .exp-block { display: grid; grid-template-columns: 130px 1fr; gap: 16px; margin-bottom: 20px; page-break-inside: avoid; }
    .exp-dates { font-size: 10.5px; color: #8e8e93; line-height: 1.6; }
    .exp-company-name { font-size: 10.5px; font-weight: 600; color: #3a3a3c; margin-top: 4px; }
    .exp-role { font-size: 14px; font-weight: 600; margin: 0 0 6px; color: #1c1c1e; }
    .exp-bullets { margin: 0; padding: 0; list-style: none; }
    .exp-bullets li { font-size: 12.5px; line-height: 1.65; color: #48484a; margin-bottom: 4px; padding-left: 12px; border-left: 2px solid #e5e5ea; }

    .project-block { display: grid; grid-template-columns: 130px 1fr; gap: 16px; margin-bottom: 16px; page-break-inside: avoid; }
    .project-stack { font-size: 10.5px; color: #8e8e93; line-height: 1.6; }
    .project-name { font-size: 13px; font-weight: 600; color: #1c1c1e; margin-bottom: 4px; }
    .project-desc { font-size: 12px; color: #48484a; line-height: 1.65; }
    .project-bullets { margin: 3px 0 0; padding: 0; list-style: none; }
    .project-bullets li { font-size: 12px; line-height: 1.65; color: #48484a; margin-bottom: 3px; padding-left: 12px; border-left: 2px solid #e5e5ea; }

    .vol-block { display: grid; grid-template-columns: 130px 1fr; gap: 16px; margin-bottom: 16px; page-break-inside: avoid; }
    .vol-dates { font-size: 10.5px; color: #8e8e93; line-height: 1.6; }
    .vol-org-name { font-size: 10.5px; font-weight: 600; color: #3a3a3c; margin-top: 4px; }
    .vol-role-title { font-size: 13px; font-weight: 600; color: #1c1c1e; margin-bottom: 4px; }
    .vol-desc { font-size: 12px; color: #48484a; line-height: 1.65; }

    .bottom-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 28px; }
    .b-label { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.22em; color: #8e8e93; margin-bottom: 12px; }
    .skill-item { font-size: 12px; line-height: 1.85; color: #48484a; }
    .b-entry { margin-bottom: 11px; }
    .b-title { font-size: 12px; font-weight: 600; color: #1c1c1e; }
    .b-meta { font-size: 11px; color: #8e8e93; }
    .b-desc { font-size: 11px; color: #48484a; line-height: 1.5; margin-top: 2px; }
  </style>
</head>
<body>
<div class="page">
  <header><h1><%= user.fullName %></h1></header>
  <div class="contact-row">
    <span><%= user.email %></span>
    <% if (user.phoneNumber) { %><span><%= user.phoneNumber %></span><% } %>
    <% if (user.linkedinUrl) { %><span><%= user.linkedinUrl.replace(/^https?:\/\/(www\.)?/, '') %></span><% } %>
    <% if (user.githubUrl) { %><span><%= user.githubUrl.replace(/^https?:\/\/(www\.)?/, '') %></span><% } %>
    <% if (user.portfolioUrl) { %><span><%= user.portfolioUrl.replace(/^https?:\/\/(www\.)?/, '') %></span><% } %>
  </div>

  <% if (ai.professionalSummary) { %><p class="summary"><%= ai.professionalSummary %></p><% } %>
  <div class="rule"></div>

  <% if (ai.refinedExperience && ai.refinedExperience.length > 0) { %>
    <div class="sl">Experience</div>
    <% ai.refinedExperience.forEach(function(exp) { %>
      <div class="exp-block">
        <div><div class="exp-dates"><%= exp.startDate %><br/><%= exp.endDate %></div><div class="exp-company-name"><%= exp.company %></div></div>
        <div><div class="exp-role"><%= exp.role %></div><ul class="exp-bullets"><% (exp.highlights || []).forEach(function(h) { %><li><%= h %></li><% }); %></ul></div>
      </div>
    <% }); %>
    <div class="rule"></div>
  <% } %>

  <% if (ai.projects && ai.projects.length > 0) { %>
    <div class="sl">Projects</div>
    <% ai.projects.forEach(function(proj) { %>
      <div class="project-block">
        <div><% if (proj.techStack && proj.techStack.length > 0) { %><div class="project-stack"><%= proj.techStack.join(' · ') %></div><% } %></div>
        <div>
          <div class="project-name"><%= proj.name %></div>
          <div class="project-desc"><%= proj.description %></div>
          <% if (proj.highlights && proj.highlights.length > 0) { %><ul class="project-bullets"><% proj.highlights.forEach(function(h) { %><li><%= h %></li><% }); %></ul><% } %>
        </div>
      </div>
    <% }); %>
    <div class="rule"></div>
  <% } %>

  <% if (ai.volunteerWork && ai.volunteerWork.length > 0) { %>
    <div class="sl">Volunteer</div>
    <% ai.volunteerWork.forEach(function(vol) { %>
      <div class="vol-block">
        <div><div class="vol-dates"><%= vol.startDate %><br/><%= vol.endDate %></div><div class="vol-org-name"><%= vol.organization %></div></div>
        <div><div class="vol-role-title"><%= vol.role %></div><div class="vol-desc"><%= vol.description %></div></div>
      </div>
    <% }); %>
    <div class="rule"></div>
  <% } %>

  <div class="bottom-grid">
    <% if (ai.relevantSkills && ai.relevantSkills.length > 0) { %>
      <div><div class="b-label">Skills</div><% ai.relevantSkills.forEach(function(s) { %><div class="skill-item"><%= s %></div><% }); %></div>
    <% } %>
    <div>
      <% if (ai.education && ai.education.length > 0) { %>
        <div class="b-label">Education</div>
        <% ai.education.forEach(function(edu) { %><div class="b-entry"><div class="b-title"><%= edu.degree %></div><div class="b-meta"><%= edu.school %></div><div class="b-meta"><%= edu.year %></div></div><% }); %>
      <% } %>
      <% if (ai.certifications && ai.certifications.length > 0) { %>
        <div class="b-label" style="margin-top:14px;">Certifications</div>
        <% ai.certifications.forEach(function(cert) { %><div class="b-entry"><div class="b-title"><%= cert.title %></div><div class="b-meta"><%= cert.issuer %> · <%= cert.date %></div></div><% }); %>
      <% } %>
    </div>
    <div>
      <% if (ai.languages && ai.languages.length > 0) { %>
        <div class="b-label">Languages</div>
        <% ai.languages.forEach(function(lang) { %><div class="b-entry"><div class="b-title"><%= lang.language %></div><div class="b-meta"><%= lang.proficiency %></div></div><% }); %>
      <% } %>
      <% if (ai.awards && ai.awards.length > 0) { %>
        <div class="b-label" style="margin-top:14px;">Awards</div>
        <% ai.awards.forEach(function(award) { %><div class="b-entry"><div class="b-title"><%= award.title %></div><div class="b-meta"><%= award.issuer %> · <%= award.date %></div><% if (award.description) { %><div class="b-desc"><%= award.description %></div><% } %></div><% }); %>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>