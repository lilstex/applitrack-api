<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    @page { margin: 48px 48px 32px; size: A4; }
    @page :first { margin: 0; size: A4; }
    html, body { margin: 0; padding: 0; background: white; orphans: 3; widows: 3; }
    body { font-family: 'Sora', 'Trebuchet MS', sans-serif; color: #1a1a2e; font-size: 13px; line-height: 1.55; }

    header { background: #16213e; padding: 30px 48px 0; }
    .header-inner { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 18px; }
    header h1 { font-size: 34px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.03em; line-height: 1; margin: 0; color: #fff; }
    .contact-block { text-align: right; font-size: 10px; color: #94a3b8; letter-spacing: 0.04em; line-height: 1.9; }
    .accent-stripe { height: 4px; background: #e05d2a; }

    .body-grid { display: grid; grid-template-columns: 1fr 208px; }
    .main-col { padding: 28px 28px 40px 48px; }
    .side-col { background: #fff8f5; padding: 28px 18px 40px 20px; }

    .sl { font-size: 8px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.24em; color: #e05d2a; border-bottom: 1px solid #e05d2a; padding-bottom: 4px; margin: 20px 0 10px; page-break-after: avoid; }
    .sl:first-child { margin-top: 0; }
    .side-sl { font-size: 7.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.22em; color: #e05d2a; border-bottom: 0.75px solid #fbd0bb; padding-bottom: 3px; margin: 18px 0 8px; page-break-after: avoid; }
    .side-sl:first-child { margin-top: 0; }

    .summary { font-size: 13.5px; line-height: 1.8; color: #2d3748; margin: 0; }

    .exp-block { margin-bottom: 18px; page-break-inside: avoid; }
    .exp-header { display: flex; justify-content: space-between; align-items: baseline; }
    .exp-role { font-size: 15px; font-weight: 700; margin: 0; color: #1a1a2e; }
    .exp-dates { font-size: 10px; color: #64748b; }
    .exp-company { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.11em; color: #e05d2a; margin-bottom: 6px; }
    .exp-bullets { margin: 0; padding: 0; list-style: none; }
    .exp-bullets li { font-size: 12.5px; line-height: 1.65; color: #374151; margin-bottom: 3px; padding-left: 11px; border-left: 2.5px solid #fbd0bb; }

    .project-block { margin-bottom: 14px; page-break-inside: avoid; }
    .project-name { font-size: 13px; font-weight: 700; color: #1a1a2e; margin-bottom: 3px; }
    .project-tech { font-size: 9.5px; font-weight: 600; color: #e05d2a; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 3px; }
    .project-desc { font-size: 12px; color: #374151; line-height: 1.6; margin-bottom: 3px; }
    .project-bullets { margin: 0; padding: 0; list-style: none; }
    .project-bullets li { font-size: 12px; line-height: 1.65; color: #374151; margin-bottom: 2px; padding-left: 11px; border-left: 2.5px solid #fbd0bb; }

    .vol-block { margin-bottom: 14px; page-break-inside: avoid; }
    .vol-header { display: flex; justify-content: space-between; align-items: baseline; }
    .vol-role { font-size: 13px; font-weight: 700; color: #1a1a2e; }
    .vol-dates { font-size: 10px; color: #64748b; }
    .vol-org { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.11em; color: #e05d2a; margin-bottom: 5px; }
    .vol-desc { font-size: 12px; color: #374151; line-height: 1.65; }

    .skill-tag { display: block; background: white; border: 1px solid #fbd0bb; border-radius: 4px; padding: 4px 10px; font-size: 10.5px; font-weight: 600; color: #1a1a2e; margin-bottom: 5px; }
    .side-block { margin-bottom: 10px; }
    .side-title { font-size: 11.5px; font-weight: 700; color: #1a1a2e; }
    .side-meta { font-size: 10px; color: #6b7280; }
    .side-desc { font-size: 10px; color: #374151; line-height: 1.5; margin-top: 2px; }
  </style>
</head>
<body>
<header>
  <div class="header-inner">
    <h1><%= user.fullName %></h1>
    <div class="contact-block">
      <div><%= user.email %></div>
      <% if (user.phoneNumber) { %><div><%= user.phoneNumber %></div><% } %>
      <% if (user.linkedinUrl) { %><div><%= user.linkedinUrl.replace(/^https?:\/\/(www\.)?/, '') %></div><% } %>
      <% if (user.githubUrl) { %><div><%= user.githubUrl.replace(/^https?:\/\/(www\.)?/, '') %></div><% } %>
    </div>
  </div>
  <div class="accent-stripe"></div>
</header>

<div class="body-grid">
  <div class="main-col">
    <% if (ai.professionalSummary) { %><div class="sl">About</div><p class="summary"><%= ai.professionalSummary %></p><% } %>

    <% if (ai.refinedExperience && ai.refinedExperience.length > 0) { %>
      <div class="sl">Experience</div>
      <% ai.refinedExperience.forEach(function(exp) { %>
        <div class="exp-block">
          <div class="exp-header"><div class="exp-role"><%= exp.role %></div><div class="exp-dates"><%= exp.startDate %> – <%= exp.endDate %></div></div>
          <div class="exp-company"><%= exp.company %></div>
          <ul class="exp-bullets"><% (exp.highlights || []).forEach(function(h) { %><li><%= h %></li><% }); %></ul>
        </div>
      <% }); %>
    <% } %>

    <% if (ai.projects && ai.projects.length > 0) { %>
      <div class="sl">Projects</div>
      <% ai.projects.forEach(function(proj) { %>
        <div class="project-block">
          <div class="project-name"><%= proj.name %></div>
          <% if (proj.techStack && proj.techStack.length > 0) { %><div class="project-tech"><%= proj.techStack.join(' · ') %></div><% } %>
          <div class="project-desc"><%= proj.description %></div>
          <% if (proj.highlights && proj.highlights.length > 0) { %><ul class="project-bullets"><% proj.highlights.forEach(function(h) { %><li><%= h %></li><% }); %></ul><% } %>
        </div>
      <% }); %>
    <% } %>

    <% if (ai.volunteerWork && ai.volunteerWork.length > 0) { %>
      <div class="sl">Volunteer Work</div>
      <% ai.volunteerWork.forEach(function(vol) { %>
        <div class="vol-block">
          <div class="vol-header"><div class="vol-role"><%= vol.role %></div><div class="vol-dates"><%= vol.startDate %> – <%= vol.endDate %></div></div>
          <div class="vol-org"><%= vol.organization %></div>
          <div class="vol-desc"><%= vol.description %></div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div class="side-col">
    <% if (ai.relevantSkills && ai.relevantSkills.length > 0) { %>
      <div class="side-sl">Skills</div>
      <% ai.relevantSkills.forEach(function(s) { %><span class="skill-tag"><%= s %></span><% }); %>
    <% } %>
    <% if (ai.education && ai.education.length > 0) { %>
      <div class="side-sl">Education</div>
      <% ai.education.forEach(function(edu) { %><div class="side-block"><div class="side-title"><%= edu.degree %></div><div class="side-meta"><%= edu.school %></div><div class="side-meta"><%= edu.year %></div></div><% }); %>
    <% } %>
    <% if (ai.certifications && ai.certifications.length > 0) { %>
      <div class="side-sl">Certifications</div>
      <% ai.certifications.forEach(function(cert) { %><div class="side-block"><div class="side-title"><%= cert.title %></div><div class="side-meta"><%= cert.issuer %></div><div class="side-meta"><%= cert.date %></div></div><% }); %>
    <% } %>
    <% if (ai.languages && ai.languages.length > 0) { %>
      <div class="side-sl">Languages</div>
      <% ai.languages.forEach(function(lang) { %><div class="side-block"><div class="side-title"><%= lang.language %></div><div class="side-meta"><%= lang.proficiency %></div></div><% }); %>
    <% } %>
    <% if (ai.awards && ai.awards.length > 0) { %>
      <div class="side-sl">Awards</div>
      <% ai.awards.forEach(function(award) { %><div class="side-block"><div class="side-title"><%= award.title %></div><div class="side-meta"><%= award.issuer %> · <%= award.date %></div><% if (award.description) { %><div class="side-desc"><%= award.description %></div><% } %></div><% }); %>
    <% } %>
  </div>
</div>
</body>
</html>
